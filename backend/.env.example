NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# MongoDB local: database recars, ket noi truoc khi mo API.
MONGODB_URI=mongodb://127.0.0.1:27017/recars

# URL frontend va backend (cookie/origin va lien ket khoi phuc).
API_ORIGIN=http://localhost:5000

# Dang ky https://sandbox.vnpayment.vn/devreg/; dien truc tiep vao backend/.env.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay-return
# IPN dang ky tren VNPAY: https://<backend-cong-khai>/api/payments/vnpay-ipn
# Khong dua TMN_CODE/HASH_SECRET vao frontend. Khoi dong lai backend sau khi sua .env.

# SMTP cho email quen mat khau; khoa bi mat chi o backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_EMAIL=

# SePay Sandbox - dien gia tri trong backend/.env, khong commit secret.
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET_KEY=
